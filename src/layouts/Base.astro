---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { profile } from '../data/profile';
import { absoluteUrl, withBase } from '../lib/url';
import { homeLd } from '../lib/seo';
// Preload the two Latin variable fonts the first screen uses. Vite hashes them to the same files the CSS loads.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  appearance?: 'immersive';
  /** Page title. Defaults to the home page title. */
  title?: string;
  description?: string;
  /** Path relative to the site base, e.g. "case-studies/x/". Defaults to the home page. */
  path?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  /** JSON-LD for the page. The home page graph (Person, WebSite, ProfilePage, FAQPage) is used when this is not set. */
  jsonLd?: Record<string, unknown>;
  /** Open Graph article fields, for article pages. */
  article?: { published: string; modified?: string; section?: string; tags?: string[] };
}

const { seo } = profile;
const props = Astro.props;
const title = props.title ?? seo.title;
const description = props.description ?? seo.description;
const canonical = absoluteUrl(props.path ?? '/', Astro.site);
const canonicalHome = absoluteUrl('/', Astro.site);
const ogImage = absoluteUrl(props.ogImage ?? seo.ogImage, Astro.site);
const ogImageAlt = props.ogImageAlt ?? seo.ogImageAlt;
const ogImageWidth = props.ogImageWidth ?? 1200;
const ogImageHeight = props.ogImageHeight ?? 630;
const ogType = props.ogType ?? 'profile';

const jsonLd = props.jsonLd ?? homeLd(Astro.site);
---

<!doctype html>
<html lang="en" data-appearance={props.appearance}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Runs before first paint so the theme never flashes.
      // Dark unless the visitor has picked light with the toggle.
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        root.dataset.theme = root.dataset.appearance ? 'dark' : stored === 'light' ? 'light' : 'dark';
        root.classList.add('js');
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={props.appearance ? '#0c1219' : seo.themeColorDark} />
    <meta name="generator" content={Astro.generator} />

    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    {seo.googleSiteVerification && <meta name="google-site-verification" content={seo.googleSiteVerification} />}
    {seo.bingSiteVerification && <meta name="msvalidate.01" content={seo.bingSiteVerification} />}

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={withBase('favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="author" type="text/plain" href={withBase('humans.txt')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="alternate" type="application/json" href={absoluteUrl('profile.json', Astro.site)} title="profile.json" />
    <link rel="alternate" type="text/plain" href={absoluteUrl('llms.txt', Astro.site)} title="llms.txt" />
    <link rel="alternate" type="text/plain" href={absoluteUrl('llms-full.txt', Astro.site)} title="llms-full.txt" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    {
      props.article ? (
        <>
          <meta property="article:published_time" content={props.article.published} />
          {props.article.modified && <meta property="article:modified_time" content={props.article.modified} />}
          <meta property="article:author" content={canonicalHome} />
          {props.article.section && <meta property="article:section" content={props.article.section} />}
          {props.article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      ) : (
        <>
          <meta property="profile:first_name" content={profile.firstName} />
          <meta property="profile:last_name" content={profile.lastName} />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-accent-ink"
    >
      {profile.a11y.skipLink}
    </a>

    <slot />

    <p id="toast" class="toast" role="status" aria-live="polite"></p>

    <script is:inline define:vars={{ dark: props.appearance ? '#0c1219' : seo.themeColorDark, light: seo.themeColorLight }}>
      (function () {
        var root = document.documentElement;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Theme toggle
        var toggle = document.getElementById('theme-toggle');
        function apply(theme) {
          root.dataset.theme = theme;
          if (toggle) toggle.setAttribute('aria-pressed', String(theme === 'light'));
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.setAttribute('content', theme === 'light' ? light : dark);
          });
        }
        function toggleTheme() {
          if (root.dataset.appearance) return;
          var next = root.dataset.theme === 'light' ? 'dark' : 'light';
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}

          // Circular reveal from the toggle button, where view transitions exist and motion is allowed.
          if (!document.startViewTransition || reduced || !toggle) return apply(next);
          var r = toggle.getBoundingClientRect();
          var x = r.left + r.width / 2;
          var y = r.top + r.height / 2;
          var radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
          root.classList.add('theme-vt');
          var transition = document.startViewTransition(function () {
            apply(next);
          });
          transition.ready
            .then(function () {
              root.animate(
                { clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + radius + 'px at ' + x + 'px ' + y + 'px)'] },
                { duration: 480, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', pseudoElement: '::view-transition-new(root)' }
              );
            })
            .catch(function () {});
          transition.finished.finally(function () {
            root.classList.remove('theme-vt');
          });
        }
        apply(root.dataset.theme || 'dark');
        if (toggle) toggle.addEventListener('click', toggleTheme);
        // The command palette asks for a theme change with this event.
        document.addEventListener('theme:toggle', toggleTheme);

        // Toast, e.g. "Email copied"
        var toast = document.getElementById('toast');
        var toastTimer;
        document.addEventListener('toast', function (e) {
          if (!toast || !e.detail) return;
          toast.textContent = e.detail;
          toast.classList.add('is-on');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toast.classList.remove('is-on');
          }, 2400);
        });

        // "Show more" on long lists and per-job details. CSS only collapses them below lg.
        document.addEventListener('click', function (e) {
          var button = e.target.closest && e.target.closest('[data-collapse-toggle]');
          var box = button && button.closest('[data-collapse], [data-fold]');
          if (!box) return;
          var open = box.classList.toggle('is-open');
          button.setAttribute('aria-expanded', String(open));
          button.querySelector('[data-collapse-label]').textContent = open ? button.dataset.less : button.dataset.more;
          if (!open && box.getBoundingClientRect().top < 0) box.scrollIntoView({ block: 'start' });
        });

        // Swipe rows get a thin progress bar. Hidden by CSS wherever the row is a plain grid.
        document.querySelectorAll('[data-swipe]').forEach(function (row) {
          var bar = document.createElement('div');
          bar.className = 'swipe-progress';
          bar.setAttribute('aria-hidden', 'true');
          bar.appendChild(document.createElement('span'));
          row.after(bar);
          var queued = false;
          function update() {
            queued = false;
            var max = row.scrollWidth - row.clientWidth;
            bar.style.setProperty('--size', String(max > 0 ? row.clientWidth / row.scrollWidth : 1));
            bar.style.setProperty('--at', String(max > 0 ? row.scrollLeft / max : 0));
          }
          row.addEventListener(
            'scroll',
            function () {
              if (!queued) {
                queued = true;
                requestAnimationFrame(update);
              }
            },
            { passive: true }
          );
          window.addEventListener('resize', update, { passive: true });
          update();
        });

        // Fade-up reveals. CSS only hides elements when motion is allowed.
        var items = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window)) {
          items.forEach(function (el) {
            el.classList.add('is-in');
          });
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );
          items.forEach(function (el) {
            io.observe(el);
          });
        }

        // Card spotlight follows the pointer. Mouse-like pointers only, and not under reduced motion.
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduced) {
          document.addEventListener(
            'pointermove',
            function (e) {
              var card = e.target.closest && e.target.closest('.card');
              if (!card) return;
              var r = card.getBoundingClientRect();
              card.style.setProperty('--mx', e.clientX - r.left + 'px');
              card.style.setProperty('--my', e.clientY - r.top + 'px');
            },
            { passive: true }
          );
        }
      })();
    </script>
    <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "be0eccab0bdf4a979607f0b77cd9e7e1"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>
