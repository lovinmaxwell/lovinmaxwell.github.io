---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
---

<Base title={`Page not found — ${profile.name}`} description="This page doesn't exist. Find your way back to the portfolio home page." path="404/">
  <main id="main" class="flex min-h-dvh flex-col items-center justify-center px-4 py-24 text-center">
    <p class="font-mono text-xs tracking-[0.18em] text-muted uppercase">404</p>
    <h1 class="mt-4 text-3xl font-semibold text-fg sm:text-4xl">Page not found</h1>
    <p class="mt-3 max-w-md text-balance text-muted">
      That page doesn't exist, or it moved. Head back to {profile.firstName}'s portfolio to see the work and get in touch.
    </p>
    <a href={withBase('/')} class="btn btn-primary mt-8">Back to home</a>
  </main>
</Base>
