---
import Icon from './Icon.astro';
import { profile, type ArchiveItem, type SocialIcon } from '../data/profile';
import { withBase } from '../lib/url';

type IconName = SocialIcon | 'hash' | 'copy' | 'sun' | 'file' | 'arrow-up-right';

interface Item {
  label: string;
  hint?: string;
  icon: IconName;
  kind: 'link' | 'copy' | 'theme';
  href?: string;
  /** Extra words the filter should match. */
  keywords?: string;
}

const { palette } = profile;
const [llms, json] = profile.agents.files;
const archive: ArchiveItem[] = profile.archive.items;
const host = (href: string) => href.replace(/^(https?:\/\/(www\.)?|mailto:)/, '');

const groups: { id: string; label: string; items: Item[] }[] = [
  {
    id: 'navigate',
    label: palette.groups.navigate,
    // The archive sits right after Projects on the page, so it does here too.
    items: [{ label: palette.topLabel, href: '#top' }, ...profile.nav]
      .flatMap((item) => (item.href === '#projects' ? [item, { label: profile.archive.title, href: '#archive' }] : [item]))
      .map((item): Item => ({ label: item.label, icon: 'hash', kind: 'link', href: item.href, keywords: item.href.slice(1) })),
  },
  {
    id: 'actions',
    label: palette.groups.actions,
    items: [
      { label: palette.actions.copyEmail, hint: profile.email, icon: 'copy', kind: 'copy' },
      { label: palette.actions.toggleTheme, icon: 'sun', kind: 'theme', keywords: 'dark light mode' },
      { label: palette.actions.openProfile, icon: 'file', kind: 'link', href: withBase(json.path), keywords: 'download' },
      { label: palette.actions.openLlms, icon: 'file', kind: 'link', href: withBase(llms.path), keywords: 'ai agents' },
    ],
  },
  {
    id: 'socials',
    label: palette.groups.socials,
    items: profile.socials.map(
      (s): Item => ({ label: s.label, hint: host(s.href), icon: s.icon, kind: 'link', href: s.href })
    ),
  },
  {
    id: 'projects',
    label: palette.groups.projects,
    items: [
      ...profile.projects.items
        .filter((p) => p.link)
        .map((p): Item => ({ label: p.name, hint: host(p.link!.href), icon: 'arrow-up-right', kind: 'link', href: p.link!.href })),
      ...archive
        .filter((a) => a.visibility === 'public' && a.link)
        .map(
          (a): Item => ({ label: a.name, hint: profile.openSource.repoLabel, icon: 'github', kind: 'link', href: a.link!.href, keywords: 'open source' })
        ),
    ],
  },
];

let n = 0;
---

<dialog id="palette" class="sheet" aria-modal="true" aria-labelledby="palette-title">
  <div class="sheet-panel" tabindex="-1">
    <button type="button" class="sheet-handle" aria-label={profile.a11y.close}></button>
    <h2 id="palette-title" class="sr-only">{palette.title}</h2>

    <div class="palette-search flex shrink-0 items-center gap-3 border-b border-line px-4">
      <Icon name="search" size={18} class="shrink-0 text-muted" />
      <input
        id="palette-input"
        type="text"
        class="h-14 min-w-0 flex-1 bg-transparent text-base text-fg outline-none placeholder:text-muted"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label={palette.placeholder}
        placeholder={palette.placeholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
      />
      <button
        type="button"
        class="kbd shrink-0 cursor-pointer max-lg:size-11 max-lg:border-0 max-lg:bg-transparent"
        data-palette-close
        aria-label={profile.a11y.close}
      >
        <span class="max-lg:hidden">Esc</span>
        <Icon name="x" size={18} class="lg:hidden" />
      </button>
    </div>

    <div id="palette-list" class="palette-list" role="listbox" aria-labelledby="palette-title">
      {
        groups.map((g) => (
          <div role="group" aria-labelledby={`palette-group-${g.id}`} data-palette-group>
            <p id={`palette-group-${g.id}`} class="label px-3 pt-3 pb-1.5">
              {g.label}
            </p>
            {g.items.map((item) => (
              <div
                id={`palette-option-${n++}`}
                class="palette-option"
                role="option"
                aria-selected="false"
                data-kind={item.kind}
                data-href={item.href}
                data-search={`${item.label} ${g.label} ${item.hint ?? ''} ${item.keywords ?? ''}`.toLowerCase()}
              >
                <Icon name={item.icon} size={16} class="shrink-0 text-muted" />
                <span class="min-w-0 flex-1 truncate">{item.label}</span>
                {item.hint && <span class="hidden max-w-[45%] truncate font-mono text-xs text-muted lg:block">{item.hint}</span>}
              </div>
            ))}
          </div>
        ))
      }
      <p class="px-3 py-8 text-center text-sm text-muted" data-palette-empty hidden>{palette.empty}</p>
    </div>

    <p class="hidden items-center gap-4 border-t border-line px-4 py-2.5 text-xs text-muted lg:flex" aria-hidden="true">
      <span class="flex items-center gap-1.5"><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd>{palette.hints.move}</span>
      <span class="flex items-center gap-1.5"><kbd class="kbd">↵</kbd>{palette.hints.select}</span>
      <span class="ml-auto flex items-center gap-1.5"><kbd class="kbd">Esc</kbd>{palette.hints.close}</span>
    </p>
  </div>
</dialog>

<div
  id="palette-data"
  hidden
  data-email={profile.email}
  data-copied={palette.toastCopied}
  data-copy-failed={palette.toastCopyFailed}
>
</div>

<script>
  import { bindSheet } from '../lib/sheet';

  const dialog = document.getElementById('palette') as HTMLDialogElement | null;
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const list = document.getElementById('palette-list');
  const data = document.getElementById('palette-data');

  if (dialog && input && list && typeof dialog.showModal === 'function') {
    const options = Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));
    const groups = Array.from(list.querySelectorAll<HTMLElement>('[data-palette-group]'));
    const empty = list.querySelector<HTMLElement>('[data-palette-empty]');
    let visible = options;
    let active = 0;

    // Every word must match. Plain substrings rank above loose letter-by-letter matches.
    const score = (query: string, text: string) => {
      let total = 0;
      for (const word of query.split(/\s+/).filter(Boolean)) {
        const at = text.indexOf(word);
        if (at === 0) total += 4;
        else if (at > 0) total += text[at - 1] === ' ' ? 3 : 2;
        else {
          let i = 0;
          for (const ch of text) if (ch === word[i]) i += 1;
          if (i < word.length) return 0;
          total += 1;
        }
      }
      return total;
    };

    const setActive = (index: number) => {
      active = visible.length ? (index + visible.length) % visible.length : -1;
      options.forEach((o) => o.setAttribute('aria-selected', String(o === visible[active])));
      const current = visible[active];
      if (current) {
        input.setAttribute('aria-activedescendant', current.id);
        current.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    };

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      const scores = new Map(options.map((o) => [o, query ? score(query, o.dataset.search ?? '') : 1]));
      options.forEach((o) => (o.hidden = !scores.get(o)));
      groups.forEach((g) => (g.hidden = !g.querySelector('[role="option"]:not([hidden])')));
      visible = options.filter((o) => !o.hidden);
      if (empty) empty.hidden = visible.length > 0;
      // Start on the best match, keeping the list in its grouped order.
      const best = visible.reduce((top, o, i) => ((scores.get(o) ?? 0) > (scores.get(visible[top]) ?? 0) ? i : top), 0);
      setActive(best);
    };

    const panel = dialog.querySelector<HTMLElement>('.sheet-panel');
    // On touch screens the list comes first: focusing the input would cover half of it with the keyboard.
    const touch = window.matchMedia('(pointer: coarse)');
    bindSheet(dialog);

    const open = () => {
      if (dialog.open) return;
      input.value = '';
      filter();
      panel?.toggleAttribute('autofocus', touch.matches);
      dialog.showModal();
      list.scrollTop = 0;
      if (!touch.matches) input.focus();
    };

    const close = () => dialog.open && dialog.close();

    const toast = (message?: string) => document.dispatchEvent(new CustomEvent('toast', { detail: message }));

    const copyEmail = async () => {
      const email = data?.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        toast(data?.dataset.copied);
      } catch {
        toast(data?.dataset.copyFailed);
      }
    };

    const run = (option: HTMLElement | undefined) => {
      if (!option) return;
      const { kind, href } = option.dataset;
      // Closing first hands focus back to wherever it was before the palette opened.
      close();
      if (kind === 'copy') void copyEmail();
      else if (kind === 'theme') document.dispatchEvent(new CustomEvent('theme:toggle'));
      else if (href) {
        if (/^https?:/.test(href)) window.open(href, '_blank', 'noopener,noreferrer');
        else window.location.href = href;
      }
    };

    input.addEventListener('input', filter);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') setActive(active + 1);
      else if (e.key === 'ArrowUp') setActive(active - 1);
      else if (e.key === 'Home') setActive(0);
      else if (e.key === 'End') setActive(visible.length - 1);
      else if (e.key === 'Enter') run(visible[active]);
      else return;
      e.preventDefault();
    });

    list.addEventListener('click', (e) => run((e.target as HTMLElement).closest<HTMLElement>('[role="option"]') ?? undefined));
    list.addEventListener('pointermove', (e) => {
      const option = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      const index = option ? visible.indexOf(option) : -1;
      if (index >= 0 && index !== active) setActive(index);
    });

    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (e) => e.target === dialog && close());
    dialog.querySelector('[data-palette-close]')?.addEventListener('click', close);

    document.querySelectorAll<HTMLElement>('[data-palette-open]').forEach((button) => {
      button.addEventListener('click', open);
      const kbd = button.querySelector('kbd');
      if (kbd && !/Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = 'Ctrl K';
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && !e.altKey && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) close();
        else open();
        return;
      }
      const target = e.target as HTMLElement | null;
      const typing = !!target?.closest('input, textarea, select, [contenteditable]');
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey && !dialog.open) {
        e.preventDefault();
        open();
      }
    });
  }
</script>

<style>
  /* The dialog shell (.sheet, .sheet-panel) lives in global.css: bottom sheet on phones, centred from sm up. */
  .sheet-panel:focus {
    outline: none;
  }

  .palette-list {
    flex: 1;
    min-height: 0;
    padding: 0 0.5rem 0.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .palette-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    cursor: pointer;
    scroll-margin-block: 2.5rem 0.5rem;
  }

  .palette-option[hidden],
  .palette-list [hidden] {
    display: none;
  }

  .palette-option[aria-selected='true'] {
    background: var(--raised);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  @media (width < 64rem) {
    .palette-option {
      min-height: 3.25rem;
      padding-inline: 0.875rem;
      border-radius: 0.875rem;
      font-size: 1rem;
    }

    /* The search row becomes a rounded field of its own, as in a native sheet. */
    .palette-search {
      margin: 0.25rem 1rem 0.5rem;
      padding-inline: 1rem 0.25rem;
      border: 1px solid var(--line);
      border-radius: 9999px;
      background: var(--raised);
    }

    .palette-search input {
      height: 3rem;
    }

    .palette-list {
      padding-inline: 0.75rem;
    }
  }
</style>
