---
import { withBase } from '../lib/url';
---
<div class="orbital-art" aria-hidden="true">
  <div class="orbital-coordinate orbital-coordinate-top"><span>Independent thought.</span><span>Connected systems.</span></div>
  <div class="orbital-field">
    <div class="orbital-meridian"></div>
    <div class="orbital-equator"></div>
    <div class="orbital-object"><img src={withBase('images/orbital-ribbon.webp')} alt="" width="1200" height="1200" fetchpriority="high" /></div>
    <span class="orbital-cross orbital-cross-a">+</span><span class="orbital-cross orbital-cross-b">+</span>
  </div>
  <div class="orbital-coordinate orbital-coordinate-bottom"><span>Form follows connection</span><span class="orbital-interaction">Move to explore</span></div>
</div>
