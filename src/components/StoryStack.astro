---
import { profile } from '../data/profile';
import { logos } from '../lib/logos';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';
// The Skill Tree: every verified tool is a node on one of four branches around the neural core.
// Nodes start locked; hovering, tapping, focusing or scrolling lights them up; a branch hub sends a pulse down its
// connections and lights what it passes. No scores, no levels.
const { items, branches, groups, kicker, title } = profile.stack;
const href = (detail: string) => detail === 'accessflow' ? withBase('classic/#project-accessflow') : `#detail-${detail}`;
const branched = branches.map(branch => ({
  branch,
  pages: branch.pages.map(page => items.filter(item => page.includes(item.category))),
}));
const nodes = branched.flatMap(({ branch, pages }) => pages.flatMap((page, pageIndex) => page.map(item => ({ item, branch, pageIndex }))));
const linked = (name: string) => Array.from(new Set(groups.filter(group => group.tools.includes(name)).flatMap(group => group.tools))).filter(tool => tool !== name);
const search = (item: typeof items[number]) => [item.name, item.detail, item.note, item.category].filter(Boolean).join(' ').toLowerCase();
---
<section id="stack" class="story-scene scene-stack" data-scene aria-labelledby="story-stack-title" data-skill-tree>
  <div class="st-head">
    <div class="st-title"><p class="scene-eyebrow">{kicker}</p><h2 id="story-stack-title">{title}</h2></div>
    <div class="st-tools">
      <label class="st-field">
        <Icon name="search" size={16} />
        <input type="search" placeholder={`Search ${items.length} tools`} aria-label={`Search ${items.length} tools and practices`} autocomplete="off" spellcheck="false" data-st-query />
        <kbd aria-hidden="true">/</kbd>
        <span class="sr-only" role="status" data-st-found></span>
      </label>
      <div class="st-chips" role="group" aria-label="Show one branch">
        <button type="button" class="st-chip" aria-pressed="true" data-st-filter="all">All</button>
        {branches.map(branch => <button type="button" class="st-chip" aria-pressed="false" data-st-filter={branch.id} style={`--b: var(--branch-${branch.id})`}><i aria-hidden="true"></i>{branch.label}</button>)}
      </div>
    </div>
  </div>
  <div class="st-tabs" role="group" aria-label="Branch" data-st-tabs>
    {branches.map((branch, index) => <button type="button" aria-pressed={String(index === 0)} data-st-tab={branch.id} style={`--b: var(--branch-${branch.id})`}><i aria-hidden="true"></i>{branch.label}</button>)}
  </div>
  <div class="st-stage" data-st-stage>
    <svg class="st-edges" aria-hidden="true" data-st-edges></svg>
    <div class="st-core" aria-hidden="true" data-st-core>
      <img src={withBase('images/hero-neural-core-poster-800.webp')} width="800" height="800" alt="" decoding="async" loading="lazy" />
      <svg class="st-ring" data-st-ring></svg>
    </div>
    {branched.map(({ branch, pages }) => (
      <>
        <button type="button" class="st-hub" data-st-hub={branch.id} aria-label={`Send a pulse through the ${branch.label} branch`} title="Send a pulse" style={`--b: var(--branch-${branch.id})`}>
          <img src={withBase(`images/stack/hub-${branch.id}.webp`)} width="52" height="52" alt="" decoding="async" loading="lazy" />
        </button>
        <div class="st-cap" data-st-cap={branch.id} style={`--b: var(--branch-${branch.id})`}>
          <p class="st-cap-t"><span>{branch.label}</span> · <span data-st-cap-count>{pages.flat().length} tools</span></p>
          <a class="st-cap-s" href={href(branch.detail)} data-detail={branch.detail}>{branch.title}<Icon name="arrow-up-right" size={13} /></a>
          <div class="st-pager" data-st-pager hidden>
            <button type="button" aria-label="Previous page" data-st-page-prev><Icon name="arrow-left" size={14} /></button>
            <span data-st-page-label>1 / {pages.length}</span>
            <button type="button" aria-label="Next page" data-st-page-next><Icon name="arrow-left" size={14} /></button>
          </div>
        </div>
      </>
    ))}
    <div class="st-nodes" data-st-nodes>
      {nodes.map(({ item, branch, pageIndex }, index) => (
        <button type="button" class="st-node" aria-pressed="false" data-st-id={index} data-st-branch={branch.id} data-st-page={pageIndex} data-st-search={search(item)} data-st-category={item.category} data-st-detail={item.detail} data-st-note={item.note} data-st-linked={linked(item.name).join('|')} style={`--b: var(--branch-${branch.id})`}>
          <span class="st-glyph" aria-hidden="true">{item.logo ? <svg viewBox={logos[item.logo].viewBox} set:html={logos[item.logo].body} /> : <span class="st-mono">{item.mono}</span>}</span>
          <span class="st-name">{item.name}</span>
        </button>
      ))}
    </div>
    <div class="st-scrim" data-st-scrim hidden></div>
    <div class="st-card glass" role="dialog" aria-labelledby="st-card-title" data-st-card hidden>
      <button type="button" class="st-close" aria-label="Close" data-st-close><Icon name="x" size={16} /></button>
      <div class="st-card-glyph" aria-hidden="true" data-st-card-glyph></div>
      <h3 id="st-card-title" data-st-card-name></h3>
      <p class="st-card-meta" data-st-card-meta></p>
      <p class="st-card-detail" data-st-card-detail></p>
      <div class="st-card-block" data-st-card-note hidden><span class="st-card-label">Used for</span><p></p></div>
      <div class="st-card-block" data-st-card-links hidden><span class="st-card-label">Linked tools</span><div class="st-card-chips"></div></div>
    </div>
  </div>
  <div class="st-hud" data-st-hud>
    <p class="st-count"><span class="st-count-label">Discovered</span><span class="st-count-value" data-st-count aria-live="polite" aria-atomic="true">0 / {items.length}</span></p>
    <p class="st-hint" data-st-hint>Hover, tap or scroll to light up a tool</p>
    <button type="button" class="sound-invite" data-sound-invite hidden>♪ Turn on sound</button>
    <div class="st-hud-actions">
      <button type="button" class="st-reveal" data-st-reveal>Reveal all</button>
      <a class="st-index" href="#detail-stack" data-detail="stack">Full index<Icon name="arrow-up-right" size={14} /></a>
    </div>
  </div>
  <div class="st-list">
    {branched.map(({ branch, pages }) => (
      <div class="st-list-branch">
        <h3>{branch.title}<small>{branch.label} · {pages.flat().length} tools</small></h3>
        <ul>{pages.flat().map(item => <li><strong>{item.name}</strong>{item.detail && <span>{item.detail}</span>}</li>)}</ul>
        <a href={href(branch.detail)} data-detail={branch.detail}>See where this was used</a>
      </div>
    ))}
  </div>
</section>
