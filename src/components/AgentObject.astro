---
---

<div class="agent-object" data-agent-object aria-hidden="true">
  <div class="agent-object-fallback"></div>
</div>

<style>
  .agent-object {
    position: relative;
    aspect-ratio: 1;
  }

  .agent-object-fallback {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 42%, color-mix(in srgb, #4da8ff 18%, transparent), transparent 55%);
  }

  .agent-object :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .agent-object.is-live :global(canvas) {
    opacity: 1;
  }

  .agent-object.is-live .agent-object-fallback {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
</style>

<script>
  import type { AgentObject } from '../lib/agent-object';

  const host = document.querySelector<HTMLElement>('[data-agent-object]');

  if (host && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'WebGL2RenderingContext' in window) {
    let object: AgentObject | null = null;

    const mount = () => {
      import('../lib/agent-object')
        .then(({ createAgentObject }) => createAgentObject(host))
        .then((instance) => {
          object = instance;
          object.setRunning(!document.hidden);
        })
        .catch(() => {});
    };

    const idle = () =>
      'requestIdleCallback' in window ? requestIdleCallback(mount, { timeout: 2000 }) : setTimeout(mount, 400);

    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });

    window.addEventListener(
      'pointermove',
      (event) => {
        const rect = host.getBoundingClientRect();
        object?.setPointer(((event.clientX - rect.left) / rect.width) * 2 - 1, ((event.clientY - rect.top) / rect.height) * 2 - 1);
      },
      { passive: true }
    );

    document.addEventListener('visibilitychange', () => {
      object?.setRunning(!document.hidden);
    });
  }
</script>
