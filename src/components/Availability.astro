---
import { profile } from '../data/profile';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p
  class:list={[
    'inline-flex items-center gap-2.5 rounded-full border border-ok-line bg-ok-bg py-1.5 pr-4 pl-3 text-sm font-medium text-ok',
    className,
  ]}
>
  <span class="relative flex size-2.5" aria-hidden="true">
    <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok-dot opacity-70"></span>
    <span class="relative inline-flex size-2.5 rounded-full bg-ok-dot"></span>
  </span>
  {profile.availability}
</p>
