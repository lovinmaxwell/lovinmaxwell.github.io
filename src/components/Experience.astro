---
import { profile } from '../data/profile';

const { experience } = profile;

// First four bullets show; a fifth sits behind "More".
const shown = 4;
---

<section id="experience" class="section border-t border-line" aria-labelledby="experience-title">
  <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] lg:gap-16">
    <div data-reveal>
      <p class="kicker">{experience.kicker}</p>
      <h2 id="experience-title" class="section-title">{experience.title}</h2>
    </div>

    <ol class="relative ml-1.5 border-l border-line lg:mt-9">
      {
        experience.jobs.map((job, i) => (
          <li class="relative pb-10 pl-7 last:pb-0 sm:pl-9" data-reveal style={`--d: ${i * 60}ms`}>
            <span
              class:list={[
                'absolute top-1.5 -left-[5px] size-[9px] rounded-full ring-4 ring-bg',
                job.current ? 'bg-accent outline outline-1 outline-fg/40' : 'bg-line-strong',
              ]}
              aria-hidden="true"
            />
            <p class="label flex flex-wrap items-center gap-x-3 gap-y-1">
              {job.period}
              {job.current && (
                <span class="rounded-full bg-accent px-2 py-0.5 text-[0.625rem] font-bold tracking-[0.12em] text-accent-ink">
                  {experience.presentLabel}
                </span>
              )}
            </p>
            <h3 class="mt-2 text-lg leading-snug font-semibold tracking-tight sm:text-xl">{job.role}</h3>
            <p class="mt-1 text-muted">
              {job.company}, {job.location}
            </p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-fg/90 sm:text-base">{job.summary}</p>
            <ul class="mt-4 grid gap-2.5 text-[0.9375rem] leading-relaxed text-muted">
              {job.bullets.slice(0, shown).map((b) => (
                <li class="flex gap-2.5">
                  <span class="mt-[0.65em] size-1 shrink-0 rounded-full bg-fg/50" aria-hidden="true" />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            {job.bullets.length > shown && (
              <details class="more group mt-2">
                <summary class="label inline-flex cursor-pointer items-center gap-1.5 rounded-md py-1.5 hover:text-fg">
                  <span class="inline-block transition-transform group-open:rotate-90" aria-hidden="true">›</span>
                  {experience.moreLabel}
                  <span class="sr-only">: {job.role}, {job.company}</span>
                </summary>
                <ul class="mt-1 grid gap-2.5 text-[0.9375rem] leading-relaxed text-muted">
                  {job.bullets.slice(shown).map((b) => (
                    <li class="flex gap-2.5">
                      <span class="mt-[0.65em] size-1 shrink-0 rounded-full bg-fg/50" aria-hidden="true" />
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
            {job.stack?.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Stack for ${job.role}`}>
                {job.stack.map((t) => (
                  <li class="chip text-xs!">{t}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .more summary {
    list-style: none;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }
</style>
