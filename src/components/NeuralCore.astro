---
import { withBase } from '../lib/url';
const poster = (width: number) => withBase(`images/hero-neural-core-poster-${width}.webp`);
---
<div class="core-art" aria-hidden="true">
  <div class="core-object" data-core-model={withBase('models/hero-neural-core.glb')}>
    <img
      class="core-poster"
      src={withBase('images/hero-neural-core-poster.webp')}
      srcset={`${poster(800)} 800w, ${poster(1200)} 1200w, ${withBase('images/hero-neural-core-poster.webp')} 1600w`}
      sizes="(width < 700px) 92vw, 46vw"
      alt=""
      width="1600"
      height="1600"
      fetchpriority="high"
    />
  </div>
  <div class="core-readout"><span>Independent thought.</span><span>Connected systems.</span></div>
  <div class="core-readout core-readout-bottom"><span>Form follows connection</span><span class="core-interaction">Move to explore</span><button type="button" class="sound-invite" data-sound-invite hidden>♪ Turn on sound</button></div>
</div>
