---
import { profile, type EducationItem } from '../data/profile';

const { education } = profile;
const items: EducationItem[] = education.items;
---

<section id="education" class="section border-t border-line" aria-labelledby="education-title">
  <div class="wrap">
    <div data-reveal>
      <p class="kicker">{education.kicker}</p>
      <h2 id="education-title" class="section-title">{education.title}</h2>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        items.map((item, i) => (
          <li class="card" data-reveal style={`--d: ${i * 70}ms`}>
            <p class="label flex items-center justify-between gap-3">
              <span>{item.label}</span>
              <span>{item.date}</span>
            </p>
            <h3 class="mt-5 text-xl leading-snug font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-1.5 text-muted">
              {item.org}{item.detail ? `, ${item.detail}` : ''}
            </p>
          </li>
        ))
      }
    </ul>

    <h3 class="label mt-8" data-reveal>{education.coursesLabel}</h3>
    <ul class="mt-3 grid gap-x-8 border-t border-line sm:grid-cols-3" data-reveal>
      {
        education.courses.map((course) => (
          <li class="border-b border-line py-4 sm:border-b-0">
            <p class="text-sm font-medium">{course.title}</p>
            <p class="mt-1.5 text-sm text-muted">
              {course.org}, {course.date}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
