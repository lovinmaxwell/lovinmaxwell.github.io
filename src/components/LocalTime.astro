---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

interface Props {
  class?: string;
}

const { localTime } = profile;
const { class: className } = Astro.props;
---

<p class:list={['flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-muted', className]}>
  <span class="inline-flex items-center gap-2 font-mono text-[0.8125rem] text-fg">
    <Icon name="clock" size={14} class="text-muted" />
    <span class="sr-only">{localTime.label}:</span>
    {localTime.city}
    <span aria-hidden="true">·</span>
    {/* Static fallback is the offset alone. The script below fills in the clock. */}
    <span data-local-time={localTime.timeZone} data-offset={localTime.offset}>{localTime.offset}</span>
  </span>
  <span>{localTime.reply}</span>
</p>

<script>
  const clocks = Array.from(document.querySelectorAll<HTMLElement>('[data-local-time]'));

  if (clocks.length) {
    const tick = () => {
      clocks.forEach((el) => {
        try {
          const time = new Intl.DateTimeFormat('en-GB', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
            timeZone: el.dataset.localTime,
          }).format(new Date());
          el.textContent = `${time} (${el.dataset.offset})`;
        } catch {
          // Keep the static offset.
        }
      });
    };
    tick();
    // Line the refresh up with the next minute, then once a minute.
    window.setTimeout(
      () => {
        tick();
        window.setInterval(tick, 60_000);
      },
      60_000 - (Date.now() % 60_000) + 50
    );
  }
</script>
