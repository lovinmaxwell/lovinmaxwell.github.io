---
import CollapseToggle from './CollapseToggle.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { profile } from '../data/profile';
import { logos } from '../lib/logos';

const { openSource } = profile;
const statusLabel = {
  merged: openSource.mergedLabel,
  closed: openSource.closedLabel,
} as const;
// Below lg the two long lists start short.
const listShown = 3;
const moreLabel = (total: number) => profile.mobile.showMore.replace('{n}', String(total - listShown));
const kindLabel = {
  pr: openSource.prLabel,
  issue: openSource.issueLabel,
} as const;
---

<section id="open-source" class="section border-t border-line" aria-labelledby="open-source-title">
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    {
      (['frappe', 'erpnext'] as const).map((key) => (
        <symbol id={`logo-${key}`} viewBox={logos[key].viewBox} set:html={logos[key].body} />
      ))
    }
  </svg>
  <div class="wrap">
    <div data-reveal>
      <p class="kicker">{openSource.kicker}</p>
      <h2 id="open-source-title" class="section-title max-w-3xl">{openSource.title}</h2>
    </div>

    <div class="mt-10" data-reveal>
      <p class="label">{openSource.picksLabel}</p>
      <p class="mt-2 max-w-2xl text-[0.9375rem] leading-relaxed text-muted sm:text-base">{openSource.picksSubline}</p>
    </div>

    <ul class="swipe mt-6 grid gap-4 lg:grid-cols-3" data-swipe>
      {
        openSource.picks.map((pick, i) => (
          <li class="card pick flex flex-col p-6! sm:p-7!" data-reveal style={`--d: ${i * 70}ms`}>
            <div class="flex items-center gap-3">
              <span class="logo-tile inline-flex size-12 items-center justify-center rounded-2xl border border-line bg-raised text-muted">
                {pick.logo ? (
                  <Logo name={pick.logo} size={26} />
                ) : (
                  <span class="font-mono text-sm font-semibold tracking-wide" aria-hidden="true">
                    {pick.mono}
                  </span>
                )}
              </span>
              <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">{pick.name}</h3>
            </div>
            <p class="mt-5 text-[0.9375rem] leading-relaxed text-muted sm:text-base">{pick.text}</p>
            <div class="mt-auto space-y-3 pt-6">
              <p>
                <a
                  href={pick.site.href}
                  class="link-underline tap inline-flex items-center gap-1.5 text-sm font-medium"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {openSource.officialLabel}: {pick.site.label}
                  <Icon name="arrow-up-right" size={14} />
                  <span class="sr-only">{profile.a11y.newTab}</span>
                </a>
              </p>
              {pick.related.length > 0 && (
                <div>
                  <p class="label">{openSource.relatedLabel}</p>
                  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 max-lg:gap-x-5">
                    {pick.related.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="link-underline tap font-mono text-sm font-medium max-lg:inline-flex max-lg:items-center"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.label}
                          <span class="sr-only">{profile.a11y.newTab}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <h3 class="label mt-14" data-reveal>{openSource.maintainLabel}</h3>
    <div data-collapse>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        openSource.maintain.map((repo, i) => (
          <li
            class="card group flex flex-col p-5!"
            data-reveal
            data-collapse-extra={i >= listShown ? '' : undefined}
            style={`--d: ${(i % 3) * 60}ms`}
          >
            <div class="flex items-start justify-between gap-3">
              <Icon name="github" size={18} class="mt-0.5 text-muted" />
              <Icon
                name="arrow-up-right"
                size={16}
                class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
              />
            </div>
            <h4 class="static mt-4 font-mono text-[0.9375rem] font-semibold">
              <a
                href={repo.href}
                class="rounded-2xl after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:outline-none focus-visible:after:rounded-2xl focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-(--focus)"
                target="_blank"
                rel="noopener noreferrer"
              >
                {repo.name}
                <span class="sr-only">{profile.a11y.newTab}</span>
              </a>
            </h4>
            <p class="mt-2 text-[0.875rem] leading-relaxed text-muted sm:text-[0.9375rem]">{repo.description}</p>
          </li>
        ))
      }
    </ul>
    {
      openSource.maintain.length > listShown && (
        <CollapseToggle
          more={moreLabel(openSource.maintain.length)}
          less={profile.mobile.showLess}
          context={openSource.maintainLabel}
          class="is-block"
        />
      )
    }
    </div>

    <h3 class="label mt-14" data-reveal>{openSource.contributedLabel}</h3>
    <div data-collapse>
    <ul class="mt-4 grid gap-3">
      {
        openSource.contributions.map((c, i) => (
          <li
            class="card group flex flex-col gap-3 p-5! sm:flex-row sm:items-center sm:justify-between"
            data-reveal
            data-collapse-extra={i >= listShown ? '' : undefined}
            style={`--d: ${i * 50}ms`}
          >
            <div class="min-w-0">
              <p class="label flex flex-wrap items-center gap-2">
                <span>{c.project}</span>
                <span class="text-fg/30" aria-hidden="true">
                  ·
                </span>
                <span>{kindLabel[c.kind]}</span>
                <span class="status" data-tone={c.status === 'merged' ? 'live' : 'soon'}>
                  {statusLabel[c.status]}
                </span>
                <span class="text-fg/40">{c.date}</span>
              </p>
              <h4 class="static mt-2 text-base font-semibold tracking-tight sm:text-lg">
                <a
                  href={c.href}
                  class="rounded-xl after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:outline-none focus-visible:after:rounded-xl focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-(--focus)"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {c.title}
                  <span class="sr-only">{profile.a11y.newTab}</span>
                </a>
              </h4>
            </div>
            <Icon
              name="arrow-up-right"
              size={18}
              class="shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
            />
          </li>
        ))
      }
    </ul>
    {
      openSource.contributions.length > listShown && (
        <CollapseToggle
          more={moreLabel(openSource.contributions.length)}
          less={profile.mobile.showLess}
          context={openSource.contributedLabel}
          class="is-block"
        />
      )
    }
    </div>
  </div>
</section>

<style>
  .pick {
    min-height: 18rem;
  }

  .logo-tile {
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .pick:hover .logo-tile {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-ink);
    }
  }
</style>
