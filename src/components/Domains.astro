---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const { domains } = profile;

const spanClass = {
  // Spans start at the breakpoint that has the columns, so a one-column grid never grows a second one.
  wide: 'sm:col-span-2',
  full: 'sm:col-span-2 lg:col-span-4',
} as const;
---

<section id="domains" class="section border-t border-line" aria-labelledby="domains-title">
  <div class="wrap">
    <div data-reveal>
      <p class="kicker">{domains.kicker}</p>
      <h2 id="domains-title" class="section-title max-w-2xl">{domains.title}</h2>
    </div>

    <ul class="swipe mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4" data-swipe>
      {
        domains.items.map((item, i) => (
          <li
            class:list={[
              'card domain flex flex-col p-5! sm:p-6!',
              item.span ? spanClass[item.span] : '',
            ]}
            data-reveal
            style={`--d: ${(i % 4) * 70}ms`}
          >
            <span class="domain-icon">
              <Icon name={item.icon} size={20} />
            </span>
            <h3 class="mt-5 text-lg leading-snug font-semibold tracking-tight sm:text-xl">{item.title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted sm:text-base">{item.text}</p>
            {item.chips && item.chips.length > 0 && (
              <ul class="mt-auto flex flex-wrap gap-2 pt-5" aria-label={`Tech for ${item.title}`}>
                {item.chips.map((c) => (
                  <li class="chip text-xs!">{c}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .domain {
    min-height: 12rem;
  }

  .domain-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--raised);
    color: var(--muted);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  @media (hover: hover) {
    .domain:hover .domain-icon {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-ink);
    }
  }
</style>
