---
import { blueprints, kinds } from '../data/architectures';
import { schematic } from '../lib/blueprint-svg';
const pad = (n: number) => String(n).padStart(2, '0');
const total = pad(blueprints.length);
---
<section id="systems" class="story-scene scene-systems" data-scene aria-labelledby="systems-title">
  <div class="chapter-heading">
    <div><p class="scene-eyebrow">Architecture, in practice</p><h2 id="systems-title">Make the pieces work together.</h2></div>
    <p class="chapter-context">Eight blueprints from real roles and products. Open one to walk its flow.</p>
  </div>
  <ul class="bp-grid" aria-label="Architecture blueprints">
    {blueprints.map(bp => {
      const k = kinds[bp.kind];
      const concept = bp.status === 'Concept';
      return (
        <li>
          <a class="bp-tile" href={`#blueprint-${pad(bp.n)}`} data-blueprint={bp.n} style={`--k:${k.color}`}>
            <span class="bp-num">{pad(bp.n)}</span>
            <span class:list={['bp-status', { 'is-concept': concept, 'is-default': bp.status === 'Delivered' }]}>{concept ? 'Concept · in development' : bp.status}</span>
            <span class="bp-art" data-loop={`/architecture/${pad(bp.n)}-${bp.loop}`}>
              <img class="bp-poster" src={`/architecture/${pad(bp.n)}-${bp.loop}-poster.webp`} alt="" width="480" height="360" loading="lazy" decoding="async" />
            </span>
            <span class="bp-meta">
              <span class="bp-kind">{k.label}</span>
              <strong class="bp-name">{bp.name}</strong>
              <span class="bp-source">{bp.source}</span>
            </span>
            <span class="bp-open" aria-hidden="true">Open flow ↗</span>
          </a>
        </li>
      );
    })}
  </ul>
  <div class="bp-panels" data-bp-panels>
    {blueprints.map(bp => {
      const k = kinds[bp.kind];
      return (
        <article class="bp-panel" id={`blueprint-${pad(bp.n)}`} data-bp-panel={bp.n} aria-labelledby={`bp-title-${bp.n}`} style={`--k:${k.color}`}>
          <div class="bp-info">
            <p class="bp-count">{pad(bp.n)} / {total}</p>
            <p class="bp-chips"><span class="bp-kind">{k.label}</span><span class:list={['bp-status', { 'is-concept': bp.status === 'Concept' }]}>{bp.status}</span></p>
            <h3 id={`bp-title-${bp.n}`}>{bp.name}</h3>
            <p class="bp-source">{bp.source}</p>
            <p class="bp-shape">Shape · {bp.shape}</p>
            <p class="bp-proof">{bp.proof}</p>
            <ul class="bp-pieces" aria-label="Technology">{bp.pieces.map(piece => <li>{piece}</li>)}</ul>
            <p class="bp-note">{bp.status === 'Concept'
              ? 'Conceptual flow for a product in development. No live visitor data is shown.'
              : 'Schematic of responsibilities described in the role, not an internal deployment diagram.'}</p>
            <div class="bp-walk">
              <p class="bp-walk-title">Walk-through · {bp.walk}</p>
              <ol class="bp-steps">{bp.hops.map(([, text]) => <li>{text}</li>)}</ol>
              <div class="bp-step-card" data-bp-step-card>
                <p class="bp-step-count" data-bp-step-count>Step 1 of {bp.hops.length}</p>
                <p class="bp-step-text" data-bp-step-text aria-live="polite" aria-atomic="true">{bp.hops[0][1]}</p>
                <div class="bp-step-actions">
                  <button type="button" data-bp-step="-1">← Previous step</button>
                  <button type="button" data-bp-step="1">Next step →</button>
                </div>
              </div>
            </div>
          </div>
          <figure class="bp-canvas" data-hops={bp.hops.map(([id]) => id).join(' ')} set:html={schematic(bp)} />
        </article>
      );
    })}
  </div>
</section>
<dialog class="bp-viewer" data-bp-viewer aria-label="Architecture blueprint">
  <button type="button" class="bp-close" data-bp-close aria-label="Close blueprint">×</button>
  <div class="bp-slot" data-bp-slot></div>
  <footer class="bp-foot">
    <button type="button" data-bp-move="-1">← Previous blueprint</button>
    <span class="bp-hint">Esc closes · ← → move between blueprints</span>
    <button type="button" data-bp-move="1">Next blueprint →</button>
  </footer>
</dialog>
