---
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

interface Props {
  /** Which other version this notice points to. */
  target: 'new' | 'agent-build';
}

const { target } = Astro.props;

const copy = {
  new: { href: withBase('/'), label: 'New', blurb: 'There is also an immersive scroll-story version of this site.', short: 'Prefer the scroll story?' },
  'agent-build': { href: withBase('agent-build/'), label: 'Classic', blurb: 'There is also a classic single-page version, with a tour of how this site was built.', short: 'Prefer a single page?' },
} as const;

const { href, label, blurb, short } = copy[target];
const storageKey = `portfolio-notice-dismissed-${target}`;
---

<aside class="version-notice" data-version-notice data-storage-key={storageKey} hidden aria-label={`Try the ${label} version`}>
  <p class="version-notice-full"><strong>Try {label}.</strong> {blurb}</p>
  <p class="version-notice-short">{short}</p>
  <a href={href} class="version-notice-link">
    View <Icon name="arrow-up-right" size={14} />
  </a>
  <button type="button" class="version-notice-close" data-version-notice-close aria-label="Dismiss">
    <Icon name="x" size={14} />
  </button>
</aside>

<style>
  .version-notice {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    max-width: calc(100vw - 2rem);
    padding: 10px 10px 10px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg);
    box-shadow: var(--shadow);
    font-size: var(--text-13);
    transform: translateX(-50%);
  }

  .version-notice[hidden] {
    display: none;
  }

  .version-notice p {
    margin: 0;
    color: var(--fg);
  }

  .version-notice p strong {
    font-weight: 650;
  }

  .version-notice-short {
    display: none;
  }

  .version-notice-link {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    padding: 5px 10px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .version-notice-close {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    color: var(--muted);
  }

  .version-notice-close:hover {
    background: var(--raised);
  }

  :global(body:has(.ab-pill)) .version-notice {
    bottom: 4.25rem;
  }

  /* Phones and small tablets: a slim docked bar. The pill above only reads
     well on one line, so here it swaps to short copy and a softer radius. */
  @media (width < 48rem) {
    .version-notice {
      right: 0.75rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      left: 0.75rem;
      gap: 4px;
      width: auto;
      max-width: none;
      padding: 4px 4px 4px 14px;
      border-radius: 14px;
      transform: none;
      animation: version-notice-in 240ms var(--ease-out) both;
    }

    :global(body:has(.ab-pill)) .version-notice {
      bottom: calc(4rem + env(safe-area-inset-bottom));
    }

    .version-notice-full {
      display: none;
    }

    .version-notice-short {
      display: block;
      flex: 1;
      min-width: 0;
    }

    .version-notice-link {
      min-height: 40px;
      padding: 0 14px;
    }

    .version-notice-close {
      width: 40px;
      height: 40px;
    }
  }

  @keyframes version-notice-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .version-notice {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-version-notice]').forEach((notice) => {
    const key = notice.dataset.storageKey;
    if (!key) return;

    let dismissed = false;
    try {
      dismissed = localStorage.getItem(key) === '1';
    } catch {
      /* storage is optional */
    }
    if (dismissed) return;

    notice.querySelector('[data-version-notice-close]')?.addEventListener('click', () => {
      notice.hidden = true;
      try {
        localStorage.setItem(key, '1');
      } catch {
        /* storage is optional */
      }
    });

    // On small screens the first view stays clear: wait until the visitor has
    // scrolled past most of it.
    const pastFirstView = () => window.scrollY > window.innerHeight * 0.6;
    if (!window.matchMedia('(max-width: 47.9375rem)').matches || pastFirstView()) {
      notice.hidden = false;
      return;
    }

    const onScroll = () => {
      if (!pastFirstView()) return;
      window.removeEventListener('scroll', onScroll);
      notice.hidden = false;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
