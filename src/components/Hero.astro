---
import Availability from './Availability.astro';
import Icon from './Icon.astro';
import LocalTime from './LocalTime.astro';
import Socials from './Socials.astro';
import { profile } from '../data/profile';

const [lead, ...rest] = profile.headline;
const now = profile.experience.jobs.find((j) => j.current) ?? profile.experience.jobs[0];
const latest = profile.projects.items.find((p) => p.featured) ?? profile.projects.items[0];
---

<section id="top" class="relative overflow-hidden border-b border-line max-lg:border-b-0">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="wrap relative grid items-center gap-10 pt-12 pb-14 max-lg:gap-3 max-lg:pt-4 max-lg:pb-3 sm:pt-16 sm:pb-16 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-12">
    <div class="hero-card">
      <Availability />

      <h1
        class="hero-title mt-6 text-[clamp(2.5rem,12vw,4.75rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance lg:text-[clamp(4.75rem,6.4vw,5.25rem)]"
      >
        <span class="block">{profile.firstName} {profile.middleName}</span>
        <span class="block"><span class="marker">{profile.lastName}</span></span>
      </h1>

      <p class="mt-6 max-w-2xl text-xl leading-snug font-medium tracking-tight sm:text-2xl">
        {lead} <span class="text-muted">{rest.join(' ')}</span>
      </p>

      <p class="mt-5 flex items-center gap-2 font-mono text-xs tracking-[0.14em] text-muted uppercase">
        <Icon name="pin" size={14} />
        {profile.location}
      </p>

      {/* Screen readers get the primary line only. The rotator is decorative. */}
      <p class="sr-only">{profile.taglines[0]}</p>
      <div
        class="tagline-rotator mt-3 max-w-xl text-base text-muted sm:text-lg"
        data-tagline-rotator
        aria-hidden="true"
      >
        <div class="tagline-viewport">
          {
            profile.taglines.map((line, i) => (
              <p class="tagline-line" data-active={i === 0 ? 'true' : 'false'}>
                {line}
              </p>
            ))
          }
        </div>
      </div>

      <div class="hero-actions mt-7 flex flex-wrap items-center gap-3">
        <a href={profile.cta.hire.href} class="btn btn-primary">
          <Icon name="mail" size={16} />
          {profile.cta.hire.label}
        </a>
        <a href={profile.cta.work.href} class="btn btn-ghost">
          {profile.cta.work.label}
          <Icon name="arrow-down" size={16} />
        </a>
        <nav aria-label={profile.a11y.socialNav} class="sm:ml-2">
          <Socials />
        </nav>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="card col-span-2 p-5!">
        <p class="label flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-ok-dot" aria-hidden="true"></span>
          {profile.hero.nowLabel}
        </p>
        <p class="mt-3 text-[0.9375rem] leading-snug font-medium">{now.role}</p>
        <p class="mt-1 text-sm text-muted">
          {now.company}{now.location ? `, ${now.location}` : ''}
        </p>
      </div>
      <div class="card p-5!">
        <p class="text-4xl font-semibold tracking-tight">{profile.hero.yearsValue}</p>
        <p class="mt-2 text-[0.8125rem] leading-snug text-muted">{profile.hero.yearsLabel}</p>
      </div>
      <a href={profile.cta.work.href} class="card group block p-5!">
        <p class="label">{profile.hero.latestLabel}</p>
        <p class="mt-3 flex items-center gap-1.5 text-[0.9375rem] font-medium">
          {latest.name}
          <Icon name="arrow-down" size={14} class="text-muted transition-transform group-hover:translate-y-0.5" />
        </p>
        <p class="mt-1 text-[0.8125rem] leading-snug text-muted">{latest.statuses[0].label}</p>
      </a>
      <div class="card col-span-2 px-5! py-4!">
        <LocalTime />
      </div>
    </div>
  </div>
</section>

<style>
  .tagline-rotator {
    /* Fixed height so the hero does not jump as lines rotate. */
    height: 3.6em;
  }

  @media (width >= 40rem) {
    .tagline-rotator {
      height: 3.25em;
    }
  }

  @media (width >= 64rem) {
    .tagline-rotator {
      height: 3.1em;
    }
  }

  .tagline-viewport {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .tagline-line {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: translateY(0.45em);
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
    pointer-events: none;
  }

  .tagline-line[data-active='true'] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .tagline-line {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tagline-rotator]');
  if (root) {
    const lines = Array.from(root.querySelectorAll<HTMLElement>('.tagline-line'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Lock height to the tallest line so wrapping never shifts the layout.
    const viewport = root.querySelector<HTMLElement>('.tagline-viewport');
    if (viewport) {
      let max = 0;
      lines.forEach((el) => {
        const prev = el.dataset.active;
        el.dataset.active = 'true';
        el.style.position = 'relative';
        max = Math.max(max, el.offsetHeight);
        el.style.position = '';
        el.dataset.active = prev ?? 'false';
      });
      if (max > 0) {
        root.style.height = max + 'px';
        viewport.style.height = max + 'px';
      }
      lines[0].dataset.active = 'true';
    }

    if (!reduce && lines.length > 1) {
      let i = 0;
      let paused = false;
      const tick = () => {
        if (paused) return;
        lines[i].dataset.active = 'false';
        i = (i + 1) % lines.length;
        lines[i].dataset.active = 'true';
      };
      const id = window.setInterval(tick, 4000);
      root.addEventListener('mouseenter', () => {
        paused = true;
      });
      root.addEventListener('mouseleave', () => {
        paused = false;
      });
      root.addEventListener('focusin', () => {
        paused = true;
      });
      root.addEventListener('focusout', () => {
        paused = false;
      });
      document.addEventListener('visibilitychange', () => {
        paused = document.hidden;
      });
    }
  }
</script>
